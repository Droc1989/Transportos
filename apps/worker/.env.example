# Workerul rulează ca sistem: cheia service_role NU ajunge niciodată în browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Adresa site-ului, pentru linkurile de urmărire din mesaje
SITE_URL=https://transportos.example

# Opțional: Twilio pentru WhatsApp și SMS. Fără ele, mesajele sunt doar afișate în consolă.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
