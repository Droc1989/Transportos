# Din `supabase status` (local) sau din Project Settings → API (cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server OSRM propriu (docs/adr/0003-harti-si-rutare.md)
OSRM_URL=http://127.0.0.1:5000

# Domeniul platformei pentru site-urile firmelor: <slug>.transportos.ro și domenii proprii.
# Gol în dezvoltare: site-urile merg la /f/<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plăți online (Stripe Connect Standard): banii intră în contul Stripe al fiecărei firme.
# Cheile platformei; webhook-ul trebuie să primească și evenimentele conturilor conectate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Doar pe server: webhook-ul Stripe și legarea contului Stripe de firmă.
SUPABASE_SERVICE_ROLE_KEY=

# Adrese (stradă și număr) cu sugestii — ADR-0012. Una dintre ele; fără niciuna, adresa e text liber.
GEOAPIFY_API_KEY=
# PHOTON_URL=https://photon.exemplu.ro
